# ============================================================
# School ERP — Environment Configuration Template
# Copy this file to .env and fill in all values before running
# ============================================================

# --- Database ---
# Runtime queries must use erp_app (not a superuser, not BYPASSRLS) so row-level
# security applies. Migrations use a privileged URL instead.
# DATABASE_URL="postgres://erp_app@127.0.0.1:54329/school_erp"
# MIGRATION_DATABASE_URL="postgres://postgres@127.0.0.1:54329/school_erp"
DATABASE_URL="postgres://erp_user:strong_password@localhost:5432/school_erp"
MIGRATION_DATABASE_URL="postgres://erp_owner:strong_password@localhost:5432/school_erp"

# --- Session ---
# The application stores a random session token as a SHA-256 hash. It does not
# read SESSION_SECRET. The cookie lifetime is 12 hours in code, not SESSION_MAX_AGE_DAYS.
SESSION_SECRET="replace_with_64_char_hex_secret"
SESSION_MAX_AGE_DAYS="30"

# --- SMS / OTP Provider (Fast2SMS or Twilio) ---
# Choose one provider and fill in the relevant block.
# Set SMS_PROVIDER to "fast2sms" or "twilio" or "mock" (for dev/testing only)
SMS_PROVIDER="mock"

# Fast2SMS (India)
FAST2SMS_API_KEY=""

# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# --- File Storage ---
# Absolute path on the server where uploaded files are stored.
# This directory must NOT be inside the public static directory.
# The application reads FILE_STORAGE_PATH. It does not read FILE_MAX_SIZE_MB.
# Uploads are rejected above 5 MB in src/lib/server/storage/upload.ts.
FILE_STORAGE_PATH="/var/www/school-erp/uploads"
FILE_MAX_SIZE_MB="5"

# --- Cashfree Payments ---
# Use sandbox credentials for testing; switch to production before go-live.
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
# "sandbox" or "production"
CASHFREE_ENV="sandbox"
# Full URL that Cashfree will POST payment events to
CASHFREE_WEBHOOK_URL="https://yourdomain.com/api/payments/webhook"

# --- Web Push Notifications ---
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourinstitute.com"

# --- Application ---
# The installed @sveltejs/adapter-node does not read ORIGIN.
# It listens on HOST and PORT (defaults apply). Behind a reverse proxy set
# PROTOCOL_HEADER=x-forwarded-proto and HOST_HEADER=x-forwarded-host when those
# headers are the ones the proxy sends. If PROTOCOL_HEADER is unset, the adapter
# assumes https. The default BODY_SIZE_LIMIT is 512K, which rejects the 5 MB
# uploads the application allows, so set it above 5 MB.
HOST="0.0.0.0"
PORT="3000"
PROTOCOL_HEADER="x-forwarded-proto"
HOST_HEADER="x-forwarded-host"
BODY_SIZE_LIMIT="6M"
# Not read by application code.
PUBLIC_APP_URL="https://yourdomain.com"
# Name of the institute (used in emails/SMS)
PUBLIC_INSTITUTE_NAME="My Institute"

# --- Geofencing ---
# Default institute location (update from Settings UI after first login)
INSTITUTE_LATITUDE="28.6139"
INSTITUTE_LONGITUDE="77.2090"
INSTITUTE_GEOFENCE_RADIUS_METERS="200"

# --- Rate Limiting ---
OTP_MAX_ATTEMPTS="5"
OTP_WINDOW_MINUTES="10"
OTP_EXPIRY_MINUTES="10"
OTP_RESEND_COOLDOWN_SECONDS="60"

# --- Backup ---
BACKUP_DIR="/var/backups/school-erp"
BACKUP_RETAIN_DAYS="30"

# --- Node Environment ---
NODE_ENV="production"
